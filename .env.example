# ==============================================================================
# EDUMATE LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# All configuration below is for running the backend locally on your development machine.
# None of these values are exposed to the client-side/browser.
#
# IN HOSTED AI STUDIO PREVIEW:
# The frontend UI loads independently. Hosted preview cannot reach your Windows localhost.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL INFRASTRUCTURE (Required for full local backend functionality)
# ------------------------------------------------------------------------------

# Local PostgreSQL connection string (Windows localhost:5432)
# Required only for local backend database persistence.
# Format: postgresql://<user>:<password>@localhost:5432/edumate
# Special characters in passwords must be URL-encoded (e.g., '#' -> '%23').
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/edumate

# Local Qdrant vector database URL (Windows localhost:6333)
# Optional: defaults to http://localhost:6333 if omitted.
QDRANT_URL=http://localhost:6333

# ------------------------------------------------------------------------------
# 2. VECTOR EMBEDDING ENGINE & COLLECTION (Non-secret configurations)
# ------------------------------------------------------------------------------

# Qdrant collection name (Optional: defaults to edumate_documents)
QDRANT_COLLECTION=edumate_documents

# Embedding fallback safety switch (Optional: defaults to false)
# When false: requires real BAAI/bge-small-en-v1.5 model; synthetic fallback is rejected.
# When true: permits deterministic hash fallback for automated tests only.
EMBEDDING_ALLOW_TEST_FALLBACK=false

# Optional Python executable path (defaults to python on Windows, python3 on Linux/macOS)
# EMBEDDING_PYTHON_PATH=python

# Python embedding health-check probe timeout in milliseconds (Optional: defaults to 30000ms / 30s)
# Accommodates PyTorch + SentenceTransformers + BAAI model + CUDA initialization on local hardware.
EMBEDDING_HEALTHCHECK_TIMEOUT_MS=30000

# Python embedding subprocess startup and BGE model loading timeout in milliseconds (Optional: defaults to 120000ms / 2 minutes)
# Accommodates first-time model loading, weight transfers to CUDA/VRAM, and memory initialization.
EMBEDDING_STARTUP_TIMEOUT_MS=120000

# ------------------------------------------------------------------------------
# 3. RESOURCE GOVERNANCE & QUOTA CONFIGURATION (Non-secret configurations)
# All have built-in safe development defaults and do NOT need manual entry.
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_MB=25
STORAGE_QUOTA_MB=500
MAX_ACTIVE_MATERIALS=50
MAX_CHUNKS_PER_DOCUMENT=10000
MAX_CHUNKS_PER_STUDENT=5000
DAILY_SEMANTIC_SEARCHES=200
MAX_RETRIEVAL_TOP_K=10
DEFAULT_RETRIEVAL_TOP_K=5
EMBEDDING_WORKER_CONCURRENCY=1

# ------------------------------------------------------------------------------
# 4. PLATFORM RUNTIME (Injected automatically in AI Studio / Cloud Run)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
APP_URL=""

# ------------------------------------------------------------------------------
# 5. AI GATEWAY & RESOURCE GOVERNANCE (Phase 8 Non-secret configurations)
# ------------------------------------------------------------------------------
# Active AI provider: 'none' (default), 'development', 'local'
AI_PROVIDER=none

# Model name / identifier (optional, provider-specific)
AI_MODEL=null

# AI Gateway execution timeout in milliseconds (default: 30000ms / 30 seconds)
AI_REQUEST_TIMEOUT_MS=30000

# Maximum input character length per request (default: 20000 characters)
AI_MAX_INPUT_CHARS=20000

# Maximum output tokens generated per request (default: 1500 tokens)
AI_MAX_OUTPUT_TOKENS=1500

# Maximum concurrent AI requests per student (default: 2)
AI_MAX_CONCURRENT_PER_STUDENT=2

# Maximum global concurrent AI requests across all students (default: 4)
AI_MAX_GLOBAL_CONCURRENT=4

# Maximum daily AI requests per student (default: 100 requests/day)
AI_REQUESTS_PER_DAY=100

# Optional local self-hosted inference endpoint base URL (e.g. Ollama, vLLM, llama.cpp)
LOCAL_AI_BASE_URL=http://127.0.0.1:11434



