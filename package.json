{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:rollback": "tsx server/db/migrate.ts --rollback",
    "db:seed": "tsx server/db/seed.ts",
    "db:seed:curriculum": "tsx server/db/seeds/question_bank.seed.ts",
    "db:seed:questions": "tsx server/db/seeds/question_bank.seed.ts",
    "db:verify": "tsx server/db/verify.ts",
    "test": "npm run test:auth && npm run test:curriculum && npm run test:quiz && npm run test:leaderboard && npm run test:materials && npm run test:doc-intel && npm run test:retrieval && npm run test:ai && npm run test:analytics && npm run db:verify",
    "test:auth": "tsx server/test/auth.test.ts",
    "test:curriculum": "tsx server/test/curriculum.test.ts",
    "test:doc-intel": "tsx server/test/document-intelligence.test.ts",
    "test:leaderboard": "tsx server/test/leaderboard.test.ts",
    "test:materials": "tsx server/test/material.test.ts",
    "test:quiz": "tsx server/test/quiz.test.ts",
    "test:retrieval": "tsx server/test/retrieval.test.ts",
    "test:ai": "tsx server/test/ai-gateway.test.ts",
    "test:analytics": "tsx server/test/analytics.test.ts",
    "test:runner": "tsx server/test/python-runner.test.ts",
    "test:load": "tsx server/test/load.test.ts",
    "test:capacity": "tsx server/test/capacity.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pdf-parse": "^1.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "argon2": "^0.45.1",
    "canvas-confetti": "^1.9.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
